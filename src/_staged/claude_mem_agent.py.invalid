# this module provides an autonomous agent in the EspireAether system
# it gathers data locally without any external calls or secrets

# module constants
TAGS = ["dataCollection", "autonomousAgent"]
INTERVAL_MIN = 5

def gather_data() -> dict:
    """
    This function collects and organizes local data
    such as system logs, system performance metrics, etc.
    The function returns a dictionary of collected data.

    :return: A dictionary containing the collected data
    """
    # collect system logs
    system_logs = []

    # collect system performance metrics
    performance_metrics = {
        "cpu_usage": 50,
        "memory_usage": 20,
        "disk_usage": 40
    }

    # create the data dictionary
    data = {
        "tags": TAGS,
        "system_logs": system_logs,
        "performance_metrics": performance_metrics
    }

    return data

# for testing purposes only
def main() -> None:
    """
    A test function that calls gather_data for demonstration purposes.
    Will not be used in production.
    """
    data = gather_data()
    print(f"Gathered data: {data}")

if __name__ == "__main__":
    main()
