# EsprieAether Environment Variables
# Copy this file to .env and fill in your values

# GitHub Integration
GITHUB_TOKEN=your_github_personal_token_here
# How to get: GitHub Settings -> Developer settings -> Personal access tokens
# Scopes needed: repo, public_repo, read:org

# G0DM0D3 Settings
GODMODE_API_KEY=local_dev_key
GODMODE_MODE=liberated

# Ollama Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Web Interface
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Router Settings
ROUTER_HOST=127.0.0.1
ROUTER_PORT=11435

# JARVIS Settings
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# Trade Cycle — paper trading settings (no real orders, trade-only keys)
TRADE_ONLY=True
TRADE_API_TOKEN=trade_only_token_no_withdraw
TRADE_MARK=TRADE_ONLY
FEEDBACK_MODEL=meta/llama-3.1-8b-instant
FEEDBACK_MAX_TOKENS=200

# Cloud Desktop
CLOUD_DESKTOP_PORT=5001
