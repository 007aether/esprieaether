# EsprieAether Environment Variables
# Copy to .env and fill in your values. NEVER commit real secrets.

# ── Telegram (recommended for reports & bot) ───────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── GitHub ─────────────────────────────────────────────────────
GITHUB_TOKEN=
# Scopes: repo (if private), public_repo

# ── Ollama / Local LLM ─────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Web & Router ───────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=5000
ROUTER_HOST=127.0.0.1
ROUTER_PORT=11435
CLOUD_DESKTOP_PORT=5001

# ── Trade Cycle (paper by default — safe) ──────────────────────
PAPER_ONLY=True
TRADE_API_TOKEN=
TRADE_MARK=TRADE_ONLY
# Only set REAL trading flags after you understand the risk model
# REAL_TRADE_ENABLED=False

# ── Optional cloud fallbacks ───────────────────────────────────
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# LLM7_API_KEY=

# ── Misc ───────────────────────────────────────────────────────
GODMODE_API_KEY=local_dev_key
GODMODE_MODE=liberated
